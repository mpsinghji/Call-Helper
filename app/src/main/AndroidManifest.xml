<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Call state detection -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- ANSWER_PHONE_CALLS: API 26+, used for voice-command answer -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Prerequisite for FOREGROUND_SERVICE_TYPE_PHONE_CALL on API 34+ -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Overlay during ringing: grants the while-in-use exemption
         Android 14 requires for background-started mic FGS, and
         shows the status overlay with mic icon to the user -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Voice commands (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Audio routing (speakerphone, ringer silence) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bluetooth: legacy (<= API 30) and new (API 31+) permission models -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallHandler">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice command listener foreground service -->
        <service
            android:name=".core.CallHandlerService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <!-- Detects incoming / answered / ended cellular calls -->
        <receiver
            android:name=".core.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
