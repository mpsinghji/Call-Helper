    <!-- About Section -->
    <string name="about_section_title">About Call Handler</string>
    <string name="about_app_version">Version %1$s (Build %2$d)</string>
    <string name="about_app_description">An intelligent hands-free incoming-call assistant for Android. Announces cellular and VoIP calls via Bluetooth, provides offline voice commands, and extracts real-time Caller-ID from contacts and Truecaller with automated false-positive filtering.</string>
    <string name="about_privacy_note">Built for privacy and safety. All call state analysis, contacts matching, and voice processing execute 100% locally on-device.</string>
