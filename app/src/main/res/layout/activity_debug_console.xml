<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 1. Console-Only Header (Requirement 18: Fullscreen Developer Console) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/containerConsoleOnlyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/console_only_title"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge">

            <ImageButton
                android:id="@+id/btnConsoleOnlyExit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen_exit"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Exit Fullscreen Console" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 2. Standard Header Toolbar (Using App Material Theme) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/debug_console_title"
            app:titleCentered="false"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge">

            <ImageButton
                android:id="@+id/btnClearLogs"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete_outline"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Clear Logs" />

            <ImageButton
                android:id="@+id/btnToggleFullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Fullscreen Console" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 3. Standard Controls Container (Hidden in Console-Only mode) -->
    <LinearLayout
        android:id="@+id/containerStandardControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <!-- Compact Material Status Card (Matches App Theme) -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility Service"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/statusAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● CHECKING"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        android:textColor="@color/status_granted" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Truecaller"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/statusTruecaller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● CHECKING"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        android:textColor="@color/status_granted" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Observation"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/statusObservation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● STOPPED"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Collapsible Developer Tools (Collapsed by default, clean Material card) -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Row -->
                <LinearLayout
                    android:id="@+id/headerDeveloperTools"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Tools" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/developer_tools_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgExpandTools"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="Expand" />

                </LinearLayout>

                <!-- Body (Collapsed by default) -->
                <LinearLayout
                    android:id="@+id/containerToolsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <!-- Secondary Tabs for Tools -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/tabAccessibility"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="A11y"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/tabSpeech"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Speech"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/tabCallerIdDebug"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Simulators"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Panel 1: Accessibility Controls -->
                    <LinearLayout
                        android:id="@+id/panelAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnOpenA11ySettings"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:layout_marginEnd="4dp"
                                android:text="Settings"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnStartObserving"
                                style="?attr/materialButtonStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="Start"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnStopObserving"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stop"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnToggleVerboseA11y"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Verbose Tree: OFF"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Panel 2: Speech Test Controls -->
                    <LinearLayout
                        android:id="@+id/panelSpeech"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnStartRecognizer"
                                style="?attr/materialButtonStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="Start Recognizer"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnStopRecognizer"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stop Recognizer"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <Button
                                android:id="@+id/btnTestAnswer"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:text="Answer"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/btnTestReject"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:text="Reject"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/btnTestSilent"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:text="Silent"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/btnTestSpeaker"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Speaker"
                                android:textSize="10sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Panel 3: Caller-ID Simulators -->
                    <LinearLayout
                        android:id="@+id/panelCallerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnSimulateMatch"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="3dp"
                                android:text="Match"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnSimulateMismatch"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="3dp"
                                android:text="Mismatch"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnSimulateWaIncoming"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="3dp"
                                android:text="WA In"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnSimulateWaOutgoing"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="WA Out"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Live Snapshot inside simulator panel -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="6dp"
                            android:padding="8dp"
                            android:background="?attr/colorSurfaceVariant">

                            <TextView
                                android:id="@+id/cardResultStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="STATUS: IDLE"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/cardCallSource"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Source: -" />

                            <TextView
                                android:id="@+id/cardDirection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Direction: -" />

                            <TextView
                                android:id="@+id/cardPhoneNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Number: None" />

                            <TextView
                                android:id="@+id/cardContactName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Contact: -" />

                            <TextView
                                android:id="@+id/cardTruecallerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Truecaller: -" />

                            <TextView
                                android:id="@+id/cardAnnouncementName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Announced: -" />

                            <TextView
                                android:id="@+id/cardSource"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Source: -" />

                            <TextView
                                android:id="@+id/cardTtsText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="TTS: -" />

                            <TextView
                                android:id="@+id/callerIdDebugText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Navigation: Material Button Toggle Group (Segmented Controls) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewHistory"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/btn_view_history"
                android:textStyle="bold"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDeveloper"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/btn_view_developer"
                android:textStyle="bold"
                android:textSize="12sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Two Dedicated Copy Buttons with 0 clipping (Matching App Material Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyCallHistory"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_copy_call_history"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="@null"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyDeveloperDetails"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_copy_developer_details"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="@null"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

        </LinearLayout>

        <!-- Developer Filter Chips (Requirement 12: ALL, GSM, WHATSAPP, VOIP, BUGS) -->
        <HorizontalScrollView
            android:id="@+id/containerDeveloperFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/chipFilterAll"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/filter_all"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipFilterGsm"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/filter_gsm"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipFilterWhatsapp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/filter_whatsapp"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipFilterVoip"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/filter_voip"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipFilterBugs"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/filter_bugs"
                    android:textSize="11sp" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- 4. Console Log Display (Uses Material Theme Surface Variant) -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardElevation="0dp">

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/logTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:scrollbars="vertical" />

        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Console-Only Bottom Action (Requirement 18: Copy Developer Details) -->
    <LinearLayout
        android:id="@+id/containerConsoleOnlyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/colorSurface"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsoleOnlyCopyDev"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_copy_developer_details"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_content_copy"
            app:iconGravity="textStart"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
